# Ranking / summarising model — runs locally via Ollama (https://ollama.com),
# no key needed. Both are optional; these are the defaults.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:latest

# Bot created via BotFather (PRD 5.5)
TELEGRAM_BOT_TOKEN=

# Sending address — must be on the Amazon approved sender list first (PRD 5.9)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=

# Send-to-Kindle address for the device
KINDLE_EMAIL=

# Which model does the ranking and summarizing: "ollama" (local, default) or "claude"
# (the `claude -p` tool on your own login, needs `claude /login`, no API key).
# LLM_BACKEND=ollama
# CLAUDE_MODEL=sonnet
